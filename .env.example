# NIVARA V2 - Backend Environment Configuration
# Copy this file to server/.env and fill in your MongoDB Atlas credentials

# MongoDB Atlas Connection URI
# Replace <username> and <password> with your Atlas database user credentials
MONGODB_URI=mongodb+srv://<username>:<password>@mywebsitecluster.61me3dd.mongodb.net/nivara?retryWrites=true&w=majority

# Database name
MONGODB_DB_NAME=nivara

# JWT Secret for authenticating sessions (replace with a long random secret in production)
JWT_SECRET=your_secure_jwt_secret_key_nivara_2026

# Backend Server Port
PORT=5000

# Client Application URL for CORS
CLIENT_URL=http://localhost:3000
